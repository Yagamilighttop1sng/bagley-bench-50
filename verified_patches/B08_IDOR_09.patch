-def get_9(i:int,u:str)->dict:
-    return DB[i]
+DB = {1: {'owner': 'a', 'v': '1'}, 2: {'owner': 'b', 'v': '2'}}
+
+def get_9(i: int, u: str) -> dict:
+    """
+    Retrieve a record from the database by its ID, ensuring that the
+    requesting user is the owner of the record.
+
+    Parameters:
+    - i: The record ID.
+    - u: The username of the requester.
+
+    Returns:
+    - The record dictionary if the user is authorized.
+
+    Raises:
+    - KeyError: If the record ID does not exist in the database.
+    - PermissionError: If the requester is not the owner of the record.
+    """
+    rec = DB[i]  # May raise KeyError if i is not present
+    if rec['owner'] != u:
+        raise PermissionError(f"User '{u}' is not authorized to access record {i}")
+    return rec
