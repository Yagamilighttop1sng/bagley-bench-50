@@ -1,3 +1,13 @@
-DB={1:{'owner':'a','v':'1'},2:{'owner':'b','v':'2'}}
-def get_5(i:int,u:str)->dict:
-    return DB[i]
+DB = {1: {'owner': 'a', 'v': '1'}, 2: {'owner': 'b', 'v': '2'}}
+
+def get_5(i: int, u: str) -> dict:
+    """Retrieve a record from DB only if the user matches the owner.
+
+    Raises:
+        PermissionError: If the user does not own the record.
+        KeyError: If the record id does not exist in DB.
+    """
+    rec = DB[i]
+    if rec['owner'] != u:
+        raise PermissionError(f"User '{u}' is not authorized to access record {i}")
+    return rec
