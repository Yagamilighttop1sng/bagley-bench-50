-    return DB[i]
+DB = {1: {'owner': 'a', 'v': '1'}, 2: {'owner': 'b', 'v': '2'}}
+
+def get_6(i: int, u: str) -> dict:
+    """
+    Retrieve a record from the database by its ID, ensuring that the
+    requesting user is the owner of the record.
+
+    Parameters
+    ----------
+    i : int
+        The record ID to fetch.
+    u : str
+        The username of the requester.
+
+    Returns
+    -------
+    dict
+        The requested record.
+
+    Raises
+    ------
+    PermissionError
+        If the requester is not the owner of the record.
+    KeyError
+        If the record ID does not exist in the database.
+    """
+    rec = DB[i]  # May raise KeyError if i is invalid
+    if rec['owner'] != u:
+        raise PermissionError(f"User '{u}' is not authorized to access record {i}")
+    return rec
